+        # Ensure the detector exists. rapidocr_onnxruntime 1.x and rapidocr
+        # 3.x both expose the detector as `text_det`, NOT `text_detector`.
+        # pymupdf4llm 1.28.0 checks the wrong attribute and always raises.
+        if not hasattr(self, "text_det") or self.text_det is None:
             raise RuntimeError("RapidOCR_DetOnly: No text_detector available.")
 
         # Run detection
